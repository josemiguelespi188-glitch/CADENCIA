# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the browser. Used by the
# Strava OAuth callback/sync routes and anything that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API app (https://www.strava.com/settings/api) — one app, both
# athletes authorize it separately via OAuth.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match this app's real deployed origin (no trailing slash) — used to
# build the Strava OAuth redirect_uri. Falls back to http://localhost:3000
# in development if unset.
NEXT_PUBLIC_SITE_URL=
