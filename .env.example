# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the browser. Used by the
# Strava OAuth callback/sync routes and anything that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Strava API app (https://www.strava.com/settings/api) — one app, both
# athletes authorize it separately via OAuth.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match this app's real deployed origin (no trailing slash) — used to
# build the Strava OAuth redirect_uri. Falls back to http://localhost:3000
# in development if unset.
NEXT_PUBLIC_SITE_URL=

# Anthropic API key (console.anthropic.com) — used only to draft the
# description written back onto a synced Strava activity. Optional: if
# unset, sync still runs (auto-complete still works), the description
# write-back step is just silently skipped.
ANTHROPIC_API_KEY=

# COROS Partner API — prep work for "Structured Workouts and Training
# Plans Sync," application pending (see CLAUDE.md's "COROS structured-
# workout push" section). These have NO baked-in default: COROS's real
# OAuth base URLs were never confirmed from this codebase (their docs
# were unreachable), so leaving these unset fails loudly and clearly
# instead of silently hitting a guessed, wrong URL. Fill in once the
# Partner API is approved and the real endpoints are known.
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
COROS_AUTHORIZE_URL=
COROS_TOKEN_URL=
COROS_API_BASE=
